# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ROS 2 / colcon
build/
install/
log/

# IDEs
.vscode/
.idea/

# Claude Code artifacts
.claude/

# OS
.DS_Store
Thumbs.db

# Secrets / local config
.env
config.local.yaml

# Logs / data
*.log
# rosbag2 data — never commit, wherever it lands
*.mcap

# Recorded bags are large/binary — ignore everything under data/, but keep
# the session-library index (README) and the per-session metadata sidecars
# so the catalog is tracked even though the bags themselves are not.
data/*
!data/recordings/
data/recordings/*
!data/recordings/README.md
!data/recordings/*.session.yaml
